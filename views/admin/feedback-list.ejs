<%- include('../partials/header', { pageTitle: 'Student Feedback & Ratings - CampusCare VFSTR', isDashboard: true }) %>

<div class="dashboard-layout">
  <%- include('../partials/sidebar') %>

  <div class="dashboard-main">
    <header class="dashboard-topbar">
      <div style="display: flex; align-items: center;">
        <button class="mobile-toggle" aria-label="Toggle navigation menu">
          <i class="bi bi-list"></i>
        </button>
        <div class="topbar-title">
          <h2>Resolution Quality & Student Feedback</h2>
          <p>Overall satisfaction rating: <strong><%= avgRating %> / 5.0</strong> (<%= totalRatings %> reviews)</p>
        </div>
      </div>

      <div class="topbar-actions">
        <a href="/admin/reports/export-feedback" class="btn btn-outline btn-sm">
          <i class="bi bi-download"></i> Export Feedback CSV
        </a>
      </div>
    </header>

    <main class="dashboard-content">
      <%- include('../partials/alerts') %>

      <!-- Rating Breakdown Cards -->
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem; margin-bottom: 2rem;">
        <% for (let star = 5; star >= 1; star--) { 
          const found = ratingBreakdown.find(r => r._id === star);
          const count = found ? found.count : 0;
        %>
          <div style="background: #ffffff; border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 1.25rem; text-align: center;">
            <div style="color: #f59e0b; font-size: 1.25rem; margin-bottom: 0.35rem;">
              <% for (let s = 1; s <= star; s++) { %><i class="bi bi-star-fill"></i><% } %>
            </div>
            <div style="font-size: 1.5rem; font-weight: 800; font-family: var(--font-heading); color: var(--text-main);"><%= count %></div>
            <div style="font-size: 0.775rem; color: var(--text-muted);"><%= star %> Star Reviews</div>
          </div>
        <% } %>
      </div>

      <!-- Feedback List Table -->
      <div class="card">
        <div class="card-header">
          <h3><i class="bi bi-chat-quote-fill" style="color: var(--warning);"></i> Feedback Entries</h3>
        </div>
        <div class="card-body" style="padding: 0;">
          <div class="table-responsive">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Grievance ID</th>
                  <th>Student Info</th>
                  <th>Rating</th>
                  <th>Student Comments</th>
                  <th>Submission Date</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody>
                <% if (feedbacks && feedbacks.length > 0) { %>
                  <% feedbacks.forEach(fb => { %>
                    <tr>
                      <td>
                        <strong><%= fb.complaint ? fb.complaint.complaintId : 'N/A' %></strong>
                        <div style="font-size: 0.75rem; color: var(--text-muted);"><%= fb.complaint ? fb.complaint.title : '' %></div>
                      </td>
                      <td>
                        <div style="font-weight: 600;"><%= fb.student ? fb.student.fullName : 'N/A' %></div>
                        <span style="font-size: 0.75rem; color: var(--text-muted);"><%= fb.student ? fb.student.regNo : '' %></span>
                      </td>
                      <td>
                        <div style="color: #f59e0b; white-space: nowrap;">
                          <% for (let i = 1; i <= 5; i++) { %>
                            <i class="bi <%= i <= fb.rating ? 'bi-star-fill' : 'bi-star' %>"></i>
                          <% } %>
                          <span style="font-weight: 700; margin-left: 0.25rem; color: var(--text-main);"><%= fb.rating %></span>
                        </div>
                      </td>
                      <td style="max-width: 320px;">
                        <p style="margin: 0; font-size: 0.875rem; line-height: 1.5;"><%= fb.description %></p>
                      </td>
                      <td style="font-size: 0.825rem; color: var(--text-muted);">
                        <%= new Date(fb.createdAt).toLocaleDateString() %>
                      </td>
                      <td>
                        <% if (fb.complaint) { %>
                          <a href="/admin/complaint/<%= fb.complaint._id %>" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-eye"></i> View
                          </a>
                        <% } %>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="6" style="text-align: center; padding: 3rem 1rem; color: var(--text-muted);">
                      No student feedback recorded yet.
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </main>
  </div>
</div>

<%- include('../partials/footer', { isDashboard: true }) %>

