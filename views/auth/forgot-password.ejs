<%- include('../partials/header', { pageTitle: 'Forgot Password - CampusCare VFSTR', isAuthPage: true, isDashboard: false }) %>

<div class="auth-wrapper">
  <div class="auth-card">
    <div class="auth-header">
      <a href="/">
        <img src="/images/logo.svg" alt="CampusCare Logo">
      </a>
      <h2>Reset Password</h2>
      <p>Enter your registered college email to receive a password reset link</p>
    </div>

    <div class="auth-body">
      <%- include('../partials/alerts') %>

      <form action="/auth/forgot-password" method="POST">
        <div class="form-group">
          <label class="form-label" for="email">Registered Email Address <span class="required">*</span></label>
          <div class="input-with-icon">
            <i class="bi bi-envelope icon-prefix"></i>
            <input type="email" id="email" name="email" class="form-control" placeholder="e.g. yourname@gmail.com" required autofocus>
          </div>
          <span class="form-hint">A secure reset token will be generated for your account.</span>
        </div>

        <button type="submit" class="btn btn-primary btn-block btn-lg" style="margin-top: 1.5rem;">
          <i class="bi bi-send-fill"></i> Send Reset Link
        </button>
      </form>
    </div>

    <div class="auth-footer">
      <span>Remember your credentials? <a href="/auth/login">Back to Sign In</a></span>
    </div>
  </div>
</div>

<%- include('../partials/footer', { isDashboard: false }) %>

