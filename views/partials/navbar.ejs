<header class="site-header">
  <div class="container">
    <nav class="site-nav">
      <a href="/" class="brand-logo">
        <img src="/images/logo.svg" alt="CampusCare VFSTR">
      </a>

      <ul class="nav-links">
        <li><a href="/" class="<%= currentPath === '/' ? 'active' : '' %>"><i class="bi bi-house-door"></i> Home</a></li>
        <li><a href="/track" class="<%= currentPath === '/track' ? 'active' : '' %>"><i class="bi bi-search"></i> Track Grievance</a></li>
        <li><a href="/#workflow"><i class="bi bi-arrow-repeat"></i> How it Works</a></li>
        <li><a href="/#features"><i class="bi bi-shield-check"></i> Features</a></li>
        <li><a href="/#contact"><i class="bi bi-telephone"></i> Contact</a></li>
      </ul>

      <div class="nav-cta">
        <% if (typeof currentUser !== 'undefined' && currentUser) { %>
          <% if (currentUser.role === 'ADMIN') { %>
            <a href="/admin/dashboard" class="btn btn-primary"><i class="bi bi-speedometer2"></i> Admin Portal</a>
          <% } else if (currentUser.role === 'STAFF') { %>
            <a href="/staff/dashboard" class="btn btn-primary"><i class="bi bi-speedometer2"></i> Staff Portal</a>
          <% } else { %>
            <a href="/student/dashboard" class="btn btn-primary"><i class="bi bi-speedometer2"></i> Student Portal</a>
          <% } %>
          <a href="/auth/logout" class="btn btn-outline" title="Log Out"><i class="bi bi-box-arrow-right"></i></a>
        <% } else { %>
          <a href="/auth/login" class="btn btn-outline-primary"><i class="bi bi-box-arrow-in-right"></i> Sign In</a>
          <a href="/auth/register" class="btn btn-primary"><i class="bi bi-person-plus"></i> Student Register</a>
        <% } %>
      </div>
    </nav>
  </div>
</header>

