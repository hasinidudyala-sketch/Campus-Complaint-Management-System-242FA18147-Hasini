<aside class="dashboard-sidebar">
  <div class="sidebar-brand">
    <a href="/">
      <img src="/images/logo.svg" alt="CampusCare VFSTR">
    </a>
  </div>

  <div class="sidebar-user">
    <img src="<%= (typeof currentUser !== 'undefined' && currentUser && currentUser.profileImage) ? currentUser.profileImage : '/images/default-avatar.svg' %>" alt="User Avatar">
    <div class="user-info">
      <div class="user-name" title="<%= currentUser ? currentUser.fullName : 'User' %>">
        <%= currentUser ? currentUser.fullName : 'User' %>
      </div>
      <span class="user-role-badge <%= currentUser ? currentUser.role.toLowerCase() : 'student' %>">
        <%= currentUser ? currentUser.role : 'STUDENT' %>
      </span>
    </div>
  </div>

  <ul class="sidebar-menu">
    <% if (currentUser && currentUser.role === 'STUDENT') { %>
      <div class="menu-category">Student Services</div>
      <li class="menu-item <%= currentPath === '/student/dashboard' ? 'active' : '' %>">
        <a href="/student/dashboard">
          <i class="bi bi-grid-1x2"></i>
          <span>Dashboard</span>
        </a>
      </li>
      <li class="menu-item <%= currentPath === '/student/submit-complaint' ? 'active' : '' %>">
        <a href="/student/submit-complaint">
          <i class="bi bi-plus-circle"></i>
          <span>Submit Grievance</span>
        </a>
      </li>
      <li class="menu-item <%= currentPath === '/student/complaints' || currentPath.startsWith('/student/complaint/') ? 'active' : '' %>">
        <a href="/student/complaints">
          <i class="bi bi-card-checklist"></i>
          <span>My Complaints</span>
        </a>
      </li>
      <li class="menu-item <%= currentPath === '/student/notifications' ? 'active' : '' %>">
        <a href="/student/notifications">
          <i class="bi bi-bell"></i>
          <span>Notifications</span>
          <% if (typeof unreadNotificationCount !== 'undefined' && unreadNotificationCount > 0) { %>
            <span class="menu-badge"><%= unreadNotificationCount %></span>
          <% } %>
        </a>
      </li>
      <li class="menu-item <%= currentPath === '/student/profile' ? 'active' : '' %>">
        <a href="/student/profile">
          <i class="bi bi-person-circle"></i>
          <span>My Profile</span>
        </a>
      </li>

    <% } else if (currentUser && currentUser.role === 'STAFF') { %>
      <div class="menu-category">Staff Action Center</div>
      <li class="menu-item <%= currentPath === '/staff/dashboard' ? 'active' : '' %>">
        <a href="/staff/dashboard">
          <i class="bi bi-grid-1x2"></i>
          <span>Dashboard</span>
        </a>
      </li>
      <li class="menu-item <%= currentPath === '/staff/complaints' || currentPath.startsWith('/staff/complaint/') ? 'active' : '' %>">
        <a href="/staff/complaints">
          <i class="bi bi-inbox-fill"></i>
          <span>Assigned Grievances</span>
        </a>
      </li>
      <li class="menu-item <%= currentPath === '/staff/notifications' ? 'active' : '' %>">
        <a href="/staff/notifications">
          <i class="bi bi-bell"></i>
          <span>Notifications</span>
          <% if (typeof unreadNotificationCount !== 'undefined' && unreadNotificationCount > 0) { %>
            <span class="menu-badge"><%= unreadNotificationCount %></span>
          <% } %>
        </a>
      </li>
      <li class="menu-item <%= currentPath === '/staff/profile' ? 'active' : '' %>">
        <a href="/staff/profile">
          <i class="bi bi-person-circle"></i>
          <span>Staff Profile</span>
        </a>
      </li>

    <% } else if (currentUser && currentUser.role === 'ADMIN') { %>
      <div class="menu-category">Administration</div>
      <li class="menu-item <%= currentPath === '/admin/dashboard' ? 'active' : '' %>">
        <a href="/admin/dashboard">
          <i class="bi bi-speedometer2"></i>
          <span>Analytics Overview</span>
        </a>
      </li>
      <li class="menu-item <%= currentPath === '/admin/complaints' || currentPath.startsWith('/admin/complaint/') ? 'active' : '' %>">
        <a href="/admin/complaints">
          <i class="bi bi-clipboard2-check"></i>
          <span>All Grievances</span>
        </a>
      </li>

      <div class="menu-category">Management</div>
      <li class="menu-item <%= currentPath === '/admin/departments' ? 'active' : '' %>">
        <a href="/admin/departments">
          <i class="bi bi-building"></i>
          <span>Departments</span>
        </a>
      </li>
      <li class="menu-item <%= currentPath === '/admin/staff' ? 'active' : '' %>">
        <a href="/admin/staff">
          <i class="bi bi-person-badge"></i>
          <span>Staff Directory</span>
        </a>
      </li>
      <li class="menu-item <%= currentPath === '/admin/students' ? 'active' : '' %>">
        <a href="/admin/students">
          <i class="bi bi-people"></i>
          <span>Student Directory</span>
        </a>
      </li>
      <li class="menu-item <%= currentPath === '/admin/feedback' ? 'active' : '' %>">
        <a href="/admin/feedback">
          <i class="bi bi-star"></i>
          <span>Student Feedback</span>
        </a>
      </li>
      <li class="menu-item <%= currentPath === '/admin/reports' ? 'active' : '' %>">
        <a href="/admin/reports">
          <i class="bi bi-file-earmark-bar-graph"></i>
          <span>Reports & CSV Export</span>
        </a>
      </li>
      <li class="menu-item <%= currentPath === '/admin/notifications' ? 'active' : '' %>">
        <a href="/admin/notifications">
          <i class="bi bi-bell"></i>
          <span>Alerts</span>
          <% if (typeof unreadNotificationCount !== 'undefined' && unreadNotificationCount > 0) { %>
            <span class="menu-badge"><%= unreadNotificationCount %></span>
          <% } %>
        </a>
      </li>
      <li class="menu-item <%= currentPath === '/admin/profile' ? 'active' : '' %>">
        <a href="/admin/profile">
          <i class="bi bi-person-circle"></i>
          <span>Admin Profile</span>
        </a>
      </li>
    <% } %>
  </ul>

  <div class="sidebar-footer">
    <a href="/auth/logout" class="btn btn-outline btn-block btn-sm">
      <i class="bi bi-box-arrow-right"></i>
      <span>Sign Out</span>
    </a>
  </div>
</aside>

