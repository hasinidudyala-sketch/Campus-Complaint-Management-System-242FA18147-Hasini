<%- include('../partials/header', { pageTitle: `Complaint #${complaint.complaintId} - CampusCare VFSTR`, isDashboard: true }) %>

<div class="dashboard-layout">
  <%- include('../partials/sidebar') %>

  <div class="dashboard-main">
    <header class="dashboard-topbar">
      <div style="display: flex; align-items: center;">
        <button class="mobile-toggle" aria-label="Toggle navigation menu">
          <i class="bi bi-list"></i>
        </button>
        <div class="topbar-title">
          <h2>Update Assigned Grievance</h2>
          <p>ID: <%= complaint.complaintId %> • Status: <%= complaint.status %></p>
        </div>
      </div>

      <div class="topbar-actions">
        <a href="/staff/complaints" class="btn btn-outline btn-sm">
          <i class="bi bi-arrow-left"></i> Assigned Queue
        </a>
      </div>
    </header>

    <main class="dashboard-content" style="max-width: 1040px;">
      <%- include('../partials/alerts') %>

      <!-- Top Summary Card -->
      <div class="card" style="margin-bottom: 1.75rem; border-top: 4px solid var(--primary);">
        <div class="card-header" style="flex-wrap: wrap; gap: 1rem;">
          <div>
            <div style="display: flex; align-items: center; gap: 0.65rem; margin-bottom: 0.35rem;">
              <span style="font-weight: 700; color: var(--primary); font-size: 0.85rem;"><%= complaint.complaintId %></span>
              <span style="color: var(--border-color);">•</span>
              <span style="font-size: 0.85rem; color: var(--text-muted);"><%= complaint.category %></span>
            </div>
            <h1 style="font-size: 1.5rem; margin: 0;"><%= complaint.title %></h1>
          </div>
          <div style="display: flex; align-items: center; gap: 0.75rem;">
            <% if (complaint.priority === 'URGENT') { %>
              <span class="badge badge-urgent">URGENT</span>
            <% } else if (complaint.priority === 'HIGH') { %>
              <span class="badge badge-high">HIGH</span>
            <% } else if (complaint.priority === 'MEDIUM') { %>
              <span class="badge badge-medium">MEDIUM</span>
            <% } else { %>
              <span class="badge badge-low">LOW</span>
            <% } %>
            <%- include('../partials/statusBadge', { status: complaint.status }) %>
          </div>
        </div>

        <div class="card-body">
          <!-- Student & Grievance Context -->
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.25rem; background-color: var(--secondary-light); padding: 1.25rem; border-radius: var(--radius-md); margin-bottom: 1.5rem;">
            <div>
              <span class="form-hint" style="display: block;">Complainant Student</span>
              <strong style="color: var(--text-main); font-size: 1rem;"><%= complaint.student ? complaint.student.fullName : 'N/A' %></strong>
              <div style="font-size: 0.8rem; color: var(--text-muted);"><%= complaint.student ? complaint.student.regNo : '' %> (<%= complaint.student ? complaint.student.department : '' %>)</div>
            </div>
            <div>
              <span class="form-hint" style="display: block;">Student Contact</span>
              <strong style="color: var(--text-main);"><%= complaint.student ? complaint.student.phone : 'N/A' %></strong>
              <div style="font-size: 0.8rem; color: var(--text-muted);"><%= complaint.student ? complaint.student.email : '' %></div>
            </div>
            <div>
              <span class="form-hint" style="display: block;">Submission Date</span>
              <strong style="color: var(--text-main);"><%= new Date(complaint.createdAt).toLocaleString() %></strong>
            </div>
            <div>
              <span class="form-hint" style="display: block;">Department</span>
              <strong style="color: var(--text-main);"><%= complaint.department ? complaint.department.name : 'General' %></strong>
            </div>
          </div>

          <!-- Description -->
          <div style="margin-bottom: 2rem;">
            <h4 style="font-size: 1.05rem; margin-bottom: 0.5rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Student Description</h4>
            <div style="background-color: #ffffff; border: 1px solid var(--border-color); padding: 1.25rem; border-radius: var(--radius-md); line-height: 1.7; font-size: 0.95rem; white-space: pre-wrap;"><%= complaint.description %></div>
          </div>

          <!-- Attachments -->
          <% if (complaint.attachments && complaint.attachments.length > 0) { %>
            <div style="margin-bottom: 2rem;">
              <h4 style="font-size: 1.05rem; margin-bottom: 0.75rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">
                <i class="bi bi-paperclip"></i> Student Uploaded Proofs (<%= complaint.attachments.length %>)
              </h4>
              <div style="display: flex; flex-wrap: wrap; gap: 0.85rem;">
                <% complaint.attachments.forEach(file => { %>
                  <a href="<%= file.path %>" target="_blank" download class="btn btn-outline" style="text-align: left; padding: 0.6rem 1rem;">
                    <% if (file.mimetype.includes('pdf')) { %>
                      <i class="bi bi-file-earmark-pdf-fill" style="color: #ef4444; font-size: 1.25rem;"></i>
                    <% } else { %>
                      <i class="bi bi-file-earmark-image-fill" style="color: #3b82f6; font-size: 1.25rem;"></i>
                    <% } %>
                    <div>
                      <div style="font-size: 0.85rem; font-weight: 600;"><%= file.originalname %></div>
                      <div style="font-size: 0.725rem; color: var(--text-muted);"><%= (file.size / 1024).toFixed(1) %> KB • View Document</div>
                    </div>
                  </a>
                <% }) %>
              </div>
            </div>
          <% } %>

          <!-- Admin Remarks if any -->
          <% if (complaint.adminRemarks) { %>
            <div style="margin-bottom: 2rem; background-color: #fef3c7; border: 1px solid #fde68a; border-radius: var(--radius-md); padding: 1.25rem;">
              <h4 style="font-size: 0.95rem; color: #92400e; margin-bottom: 0.35rem;">
                <i class="bi bi-shield-exclamation"></i> Administrator Instructions
              </h4>
              <p style="margin: 0; color: #78350f; font-size: 0.925rem;"><%= complaint.adminRemarks %></p>
            </div>
          <% } %>
        </div>
      </div>

      <!-- Action Panel: Update Status & Remarks -->
      <div class="card" style="margin-bottom: 2rem; border-top: 4px solid var(--success);">
        <div class="card-header">
          <h3><i class="bi bi-pencil-square" style="color: var(--success);"></i> Take Action / Update Grievance Status</h3>
        </div>
        <div class="card-body">
          <form action="/staff/complaint/<%= complaint._id %>/update-status" method="POST">
            <div class="form-group">
              <label class="form-label" for="status">Grievance Status <span class="required">*</span></label>
              <select id="status" name="status" class="form-select" required>
                <option value="IN PROGRESS" <%= complaint.status === 'IN PROGRESS' ? 'selected' : '' %>>IN PROGRESS (Active inspection / repairs)</option>
                <option value="RESOLVED" <%= complaint.status === 'RESOLVED' ? 'selected' : '' %>>RESOLVED (Work completed / solution provided)</option>
                <option value="ASSIGNED" <%= complaint.status === 'ASSIGNED' ? 'selected' : '' %>>ASSIGNED (Acknowledged)</option>
              </select>
            </div>

            <div class="form-group">
              <label class="form-label" for="staffRemarks">Staff Progress Remarks</label>
              <textarea id="staffRemarks" name="staffRemarks" rows="3" class="form-control" placeholder="Add inspection notes, estimated completion, or internal remarks..."><%= complaint.staffRemarks || '' %></textarea>
              <span class="form-hint">These remarks will be visible to the student and administration in the audit timeline.</span>
            </div>

            <div class="form-group">
              <label class="form-label" for="resolutionDetails">Final Resolution Details (Required when marking RESOLVED)</label>
              <textarea id="resolutionDetails" name="resolutionDetails" rows="4" class="form-control" placeholder="Specify exactly how the issue was resolved (e.g., replaced equipment, adjusted grade/memo, sanitation completed)..."><%= complaint.resolutionDetails || '' %></textarea>
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 1rem; margin-top: 1.5rem;">
              <a href="/staff/complaints" class="btn btn-outline">Cancel</a>
              <button type="submit" class="btn btn-primary btn-lg">
                <i class="bi bi-check-circle-fill"></i> Save & Broadcast Update
              </button>
            </div>
          </form>
        </div>
      </div>

      <!-- Audit History -->
      <div class="card">
        <div class="card-header">
          <h3><i class="bi bi-clock-history"></i> Audit Timeline</h3>
        </div>
        <div class="card-body">
          <div class="timeline">
            <% if (complaint.statusHistory && complaint.statusHistory.length > 0) { %>
              <% complaint.statusHistory.forEach((hist, idx) => { %>
                <div class="timeline-item">
                  <div class="timeline-marker <%= hist.status === 'RESOLVED' || hist.status === 'CLOSED' ? 'resolved' : (idx === complaint.statusHistory.length - 1 ? 'active' : '') %>"></div>
                  <div class="timeline-content">
                    <div class="timeline-header">
                      <span class="timeline-title"><%= hist.status %></span>
                      <span class="timeline-date"><%= new Date(hist.timestamp).toLocaleString() %></span>
                    </div>
                    <% if (hist.updatedBy) { %>
                      <div class="timeline-user">By: <%= hist.updatedBy.fullName %> (<%= hist.updatedBy.designation || hist.updatedBy.role %>)</div>
                    <% } %>
                    <% if (hist.remarks) { %>
                      <div class="timeline-remark"><%= hist.remarks %></div>
                    <% } %>
                  </div>
                </div>
              <% }) %>
            <% } %>
          </div>
        </div>
      </div>
    </main>
  </div>
</div>

<%- include('../partials/footer', { isDashboard: true }) %>

