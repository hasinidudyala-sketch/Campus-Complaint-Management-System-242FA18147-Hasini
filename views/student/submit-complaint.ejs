<%- include('../partials/header', { pageTitle: 'Submit Grievance - CampusCare VFSTR', isDashboard: true }) %>

<div class="dashboard-layout">
  <%- include('../partials/sidebar') %>

  <div class="dashboard-main">
    <header class="dashboard-topbar">
      <div style="display: flex; align-items: center;">
        <button class="mobile-toggle" aria-label="Toggle navigation menu">
          <i class="bi bi-list"></i>
        </button>
        <div class="topbar-title">
          <h2>Lodge Campus Grievance</h2>
          <p>VFSTR Hyderabad Campus Redressal Portal</p>
        </div>
      </div>

      <div class="topbar-actions">
        <a href="/student/complaints" class="btn btn-outline btn-sm">
          <i class="bi bi-arrow-left"></i> My Complaints
        </a>
      </div>
    </header>

    <main class="dashboard-content" style="max-width: 960px;">
      <%- include('../partials/alerts') %>

      <div class="card">
        <div class="card-header">
          <h3><i class="bi bi-pencil-square" style="color: var(--primary);"></i> Grievance Registration Form</h3>
          <span style="font-size: 0.8rem; color: var(--text-muted);"><span class="required" style="color: var(--danger);">*</span> Marked fields are mandatory</span>
        </div>

        <div class="card-body">
          <form action="/student/submit-complaint" method="POST" enctype="multipart/form-data">
            <!-- Title -->
            <div class="form-group">
              <label class="form-label" for="title">Grievance Title / Short Subject <span class="required">*</span></label>
              <input type="text" id="title" name="title" class="form-control" placeholder="Brief summary of the issue (e.g. Lab 3 Workstation Hardware Fault)" required minlength="5" maxlength="200" autofocus>
              <span class="form-hint">Keep title precise and clear (5 - 200 characters).</span>
            </div>

            <!-- Category & Department -->
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem;">
              <div class="form-group">
                <label class="form-label" for="category">Complaint Category <span class="required">*</span></label>
                <select id="category" name="category" class="form-select" required>
                  <option value="" disabled selected>Select Category...</option>
                  <% categories.forEach(cat => { %>
                    <option value="<%= cat %>"><%= cat %></option>
                  <% }) %>
                </select>
              </div>

              <div class="form-group">
                <label class="form-label" for="department">Concerned Department</label>
                <select id="department" name="department" class="form-select">
                  <option value="">General / Let Administrator Decide</option>
                  <% departments.forEach(dept => { %>
                    <option value="<%= dept._id %>"><%= dept.name %> (<%= dept.code %>)</option>
                  <% }) %>
                </select>
                <span class="form-hint">If unsure, leave as General and Administration will assign.</span>
              </div>
            </div>

            <!-- Priority -->
            <div class="form-group">
              <label class="form-label" for="priority">Urgency / Priority Level</label>
              <select id="priority" name="priority" class="form-select">
                <option value="LOW">Low (Routine queries or general suggestions)</option>
                <option value="MEDIUM" selected>Medium (Standard campus issues)</option>
                <option value="HIGH">High (Disrupting coursework, lab, or hostel living)</option>
                <option value="URGENT">Urgent (Safety, anti-ragging, or medical emergencies)</option>
              </select>
            </div>

            <!-- Detailed Description -->
            <div class="form-group">
              <label class="form-label" for="description">Detailed Grievance Description <span class="required">*</span></label>
              <textarea id="description" name="description" rows="5" class="form-control" placeholder="Please elaborate the issue with exact location (room number, lab, block), dates, and circumstances..." required minlength="10"></textarea>
              <span class="form-hint">Provide comprehensive details so faculty or maintenance staff can act promptly.</span>
            </div>

            <!-- Multer File Upload -->
            <div class="form-group" style="background-color: var(--secondary-light); border: 2px dashed var(--border-color); border-radius: var(--radius-md); padding: 1.5rem; text-align: center;">
              <i class="bi bi-cloud-arrow-up-fill" style="font-size: 2.5rem; color: var(--primary); display: block; margin-bottom: 0.5rem;"></i>
              <label class="form-label" for="attachments" style="cursor: pointer; margin-bottom: 0.25rem;">
                <span style="color: var(--primary); font-weight: 700;">Click to upload proof / attachments</span> or drag files here
              </label>
              <p style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 0.75rem;">Allowed formats: JPG, JPEG, PNG, PDF (Max 5MB per file, up to 5 attachments)</p>
              <input type="file" id="attachments" name="attachments" multiple accept=".jpg,.jpeg,.png,.pdf" class="form-control" style="max-width: 380px; margin: 0 auto; background: #ffffff;">
            </div>

            <div style="margin-top: 2rem; display: flex; justify-content: flex-end; gap: 1rem;">
              <a href="/student/dashboard" class="btn btn-outline">Cancel</a>
              <button type="submit" class="btn btn-primary btn-lg">
                <i class="bi bi-send-fill"></i> Submit Grievance
              </button>
            </div>
          </form>
        </div>
      </div>
    </main>
  </div>
</div>

<%- include('../partials/footer', { isDashboard: true }) %>

