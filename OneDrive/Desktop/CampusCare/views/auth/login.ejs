<%- include('../partials/header', { pageTitle: 'Sign In - CampusCare VFSTR', isAuthPage: true, isDashboard: false }) %>

<div class="auth-wrapper">
  <div class="auth-card">
    <div class="auth-header">
      <a href="/">
        <img src="/images/logo.svg" alt="CampusCare Logo">
      </a>
      <h2>Member Sign In</h2>
      <p>VFSTR Hyderabad Campus Complaint Portal</p>
    </div>

    <div class="auth-body">
      <%- include('../partials/alerts') %>

      <form action="/auth/login" method="POST">
        <div class="form-group">
          <label class="form-label" for="email">Email Address (Campus or Personal) <span class="required">*</span></label>
          <div class="input-with-icon">
            <i class="bi bi-envelope icon-prefix"></i>
            <input type="email" id="email" name="email" class="form-control" placeholder="e.g. yourname@gmail.com" required autofocus>
          </div>
        </div>

        <div class="form-group">
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <label class="form-label" for="password">Password <span class="required">*</span></label>
            <a href="/auth/forgot-password" style="font-size: 0.8rem; font-weight: 500;">Forgot Password?</a>
          </div>
          <div class="input-with-icon">
            <i class="bi bi-lock icon-prefix"></i>
            <input type="password" id="password" name="password" class="form-control" placeholder="••••••••" required>
            <button type="button" class="toggle-password" data-target="password" aria-label="Toggle password visibility">
              <i class="bi bi-eye"></i>
            </button>
          </div>
        </div>

        <button type="submit" class="btn btn-primary btn-block btn-lg" style="margin-top: 1.5rem;">
          <i class="bi bi-box-arrow-in-right"></i> Sign In to Portal
        </button>
      </form>

      <!-- Quick Fill Credentials Box for College Project Viva -->
      <div class="demo-credentials-box">
        <h5><i class="bi bi-key-fill"></i> Project Viva Quick Demo Credentials:</h5>
        <div class="cred-item" onclick="fillCredentials('admin@vfstr.ac.in', 'Admin@123')">
          <span><strong>Administrator:</strong> admin@vfstr.ac.in</span>
          <span>(Click to fill)</span>
        </div>
        <div class="cred-item" onclick="fillCredentials('staff.cse@vfstr.ac.in', 'Staff@123')">
          <span><strong>Staff (CSE):</strong> staff.cse@vfstr.ac.in</span>
          <span>(Click to fill)</span>
        </div>
        <div class="cred-item" onclick="fillCredentials('student1@vfstr.ac.in', 'Student@123')">
          <span><strong>Student:</strong> student1@vfstr.ac.in</span>
          <span>(Click to fill)</span>
        </div>
      </div>
    </div>

    <div class="auth-footer">
      <span>New student? <a href="/auth/register">Create a Student Account</a></span>
      <div style="margin-top: 0.5rem;">
        <a href="/" style="font-size: 0.825rem; color: var(--text-muted);"><i class="bi bi-arrow-left"></i> Return to Campus Homepage</a>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer', { isDashboard: false }) %>

