<%- include('../partials/header', { pageTitle: 'Staff Dashboard - CampusCare VFSTR', isDashboard: true }) %>

<div class="dashboard-layout">
  <%- include('../partials/sidebar') %>

  <div class="dashboard-main">
    <header class="dashboard-topbar">
      <div style="display: flex; align-items: center;">
        <button class="mobile-toggle" aria-label="Toggle navigation menu">
          <i class="bi bi-list"></i>
        </button>
        <div class="topbar-title">
          <h2>Staff Action Center</h2>
          <p><%= user.fullName %> • <%= user.designation %> (<%= user.department %>)</p>
        </div>
      </div>

      <div class="topbar-actions">
        <a href="/staff/notifications" class="notif-bell" title="Notifications">
          <i class="bi bi-bell"></i>
          <% if (typeof unreadCount !== 'undefined' && unreadCount > 0) { %>
            <span class="notif-badge"><%= unreadCount %></span>
          <% } %>
        </a>
        <a href="/staff/complaints" class="btn btn-primary btn-sm">
          <i class="bi bi-inbox-fill"></i> View Assigned Queue
        </a>
      </div>
    </header>

    <main class="dashboard-content">
      <%- include('../partials/alerts') %>

      <!-- Dynamic Staff Statistics -->
      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-icon primary">
            <i class="bi bi-clipboard2-pulse-fill"></i>
          </div>
          <div class="stat-info">
            <div class="stat-value"><%= stats.total %></div>
            <div class="stat-label">Total Assigned</div>
          </div>
        </div>

        <div class="stat-card">
          <div class="stat-icon warning">
            <i class="bi bi-hourglass-split"></i>
          </div>
          <div class="stat-info">
            <div class="stat-value"><%= stats.pending %></div>
            <div class="stat-label">Newly Assigned</div>
          </div>
        </div>

        <div class="stat-card">
          <div class="stat-icon info">
            <i class="bi bi-tools"></i>
          </div>
          <div class="stat-info">
            <div class="stat-value"><%= stats.inProgress %></div>
            <div class="stat-label">In Progress</div>
          </div>
        </div>

        <div class="stat-card">
          <div class="stat-icon success">
            <i class="bi bi-patch-check-fill"></i>
          </div>
          <div class="stat-info">
            <div class="stat-value"><%= stats.resolved %></div>
            <div class="stat-label">Resolved / Closed</div>
          </div>
        </div>
      </div>

      <!-- Priority Alert Banner if urgent complaints exist -->
      <% if (stats.urgent > 0) { %>
        <div style="background-color: var(--danger-light); border: 1px solid #fecaca; border-left: 5px solid var(--danger); padding: 1.25rem 1.75rem; border-radius: var(--radius-md); margin-bottom: 2rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
          <div style="display: flex; align-items: center; gap: 1rem;">
            <i class="bi bi-exclamation-triangle-fill" style="color: var(--danger); font-size: 1.75rem;"></i>
            <div>
              <strong style="color: #991b1b; font-size: 1.05rem;">Urgent Attention Required</strong>
              <p style="color: #991b1b; margin: 0; font-size: 0.9rem;">You have <%= stats.urgent %> urgent grievance(s) in your queue awaiting immediate inspection and resolution.</p>
            </div>
          </div>
          <a href="/staff/complaints?priority=URGENT" class="btn btn-danger btn-sm">Review Urgent Items</a>
        </div>
      <% } %>

      <!-- Recent Assigned Complaints -->
      <div class="card">
        <div class="card-header">
          <h3><i class="bi bi-inbox" style="color: var(--primary);"></i> Recently Assigned Grievances</h3>
          <a href="/staff/complaints" class="btn btn-outline btn-sm">View Full Queue</a>
        </div>
        <div class="card-body" style="padding: 0;">
          <div class="table-responsive">
            <table class="data-table">
              <thead>
                <tr>
                  <th>ID</th>
                  <th>Student Info</th>
                  <th>Grievance Title</th>
                  <th>Priority</th>
                  <th>Current Status</th>
                  <th>Assigned Date</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody>
                <% if (recentComplaints && recentComplaints.length > 0) { %>
                  <% recentComplaints.forEach(complaint => { %>
                    <tr>
                      <td><strong><%= complaint.complaintId %></strong></td>
                      <td>
                        <div style="font-weight: 600;"><%= complaint.student ? complaint.student.fullName : 'Student' %></div>
                        <span style="font-size: 0.775rem; color: var(--text-muted);"><%= complaint.student ? complaint.student.regNo : '' %></span>
                      </td>
                      <td>
                        <a href="/staff/complaint/<%= complaint._id %>" style="font-weight: 600; color: var(--text-main);">
                          <%= complaint.title %>
                        </a>
                      </td>
                      <td>
                        <% if (complaint.priority === 'URGENT') { %>
                          <span class="badge badge-urgent">URGENT</span>
                        <% } else if (complaint.priority === 'HIGH') { %>
                          <span class="badge badge-high">HIGH</span>
                        <% } else if (complaint.priority === 'MEDIUM') { %>
                          <span class="badge badge-medium">MEDIUM</span>
                        <% } else { %>
                          <span class="badge badge-low">LOW</span>
                        <% } %>
                      </td>
                      <td>
                        <%- include('../partials/statusBadge', { status: complaint.status }) %>
                      </td>
                      <td style="font-size: 0.85rem; color: var(--text-muted);">
                        <%= new Date(complaint.updatedAt).toLocaleDateString() %>
                      </td>
                      <td>
                        <a href="/staff/complaint/<%= complaint._id %>" class="btn btn-outline-primary btn-sm">
                          <i class="bi bi-pencil-square"></i> Act / Update
                        </a>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="7" style="text-align: center; padding: 3rem 1rem; color: var(--text-muted);">
                      <i class="bi bi-check2-circle" style="font-size: 2.5rem; display: block; margin-bottom: 0.5rem; color: var(--success);"></i>
                      No grievances currently assigned to your queue.
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </main>
  </div>
</div>

<%- include('../partials/footer', { isDashboard: true }) %>

