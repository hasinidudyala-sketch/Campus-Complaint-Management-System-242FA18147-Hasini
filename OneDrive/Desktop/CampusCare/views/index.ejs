<%- include('partials/header', { pageTitle: 'CampusCare - VFSTR Hyderabad Campus Complaint Management System', isDashboard: false }) %>
<%- include('partials/navbar') %>

<main class="main-content">
  <!-- Hero Section -->
  <section class="hero-section" style="background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 60%, #1e40af 100%); color: #ffffff; padding: 5.5rem 0 4.5rem; position: relative; overflow: hidden;">
    <div class="container">
      <div style="max-width: 780px;">
        <div style="display: inline-flex; align-items: center; gap: 0.5rem; background: rgba(255, 255, 255, 0.12); backdrop-filter: blur(8px); border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 9999px; padding: 0.4rem 1.1rem; font-size: 0.85rem; font-weight: 600; margin-bottom: 1.5rem; letter-spacing: 0.5px;">
          <i class="bi bi-mortarboard-fill" style="color: #38bdf8;"></i> VFSTR HYDERABAD CAMPUS • GRIEVANCE REDRESSAL PORTAL
        </div>
        <h1 style="font-size: 3.25rem; font-weight: 800; line-height: 1.15; margin-bottom: 1.25rem; color: #ffffff;">
          A Seamless, Transparent Grievance Redressal Portal
        </h1>
        <p style="font-size: 1.2rem; color: #cbd5e1; margin-bottom: 2.25rem; line-height: 1.6;">
          <strong>CampusCare</strong> empowers students, staff, and administration at <strong>VFSTR Hyderabad Campus</strong> with real-time complaint tracking, departmental delegation, and swift time-bound resolutions.
        </p>

        <div style="display: flex; flex-wrap: wrap; gap: 1rem;">
          <% if (typeof currentUser !== 'undefined' && currentUser) { %>
            <a href="/student/submit-complaint" class="btn btn-lg" style="background-color: #38bdf8; color: #0f172a; font-weight: 700;">
              <i class="bi bi-pencil-square"></i> Lodge a Grievance
            </a>
            <a href="/student/dashboard" class="btn btn-lg btn-outline" style="color: #ffffff; border-color: rgba(255,255,255,0.4);">
              <i class="bi bi-speedometer2"></i> Open Dashboard
            </a>
          <% } else { %>
            <a href="/auth/register" class="btn btn-lg" style="background-color: #38bdf8; color: #0f172a; font-weight: 700;">
              <i class="bi bi-person-plus-fill"></i> Student Registration
            </a>
            <a href="/auth/login" class="btn btn-lg" style="background-color: #ffffff; color: #1e3a8a; font-weight: 700;">
              <i class="bi bi-box-arrow-in-right"></i> Member Login
            </a>
            <a href="/track" class="btn btn-lg btn-outline" style="color: #ffffff; border-color: rgba(255,255,255,0.4);">
              <i class="bi bi-search"></i> Quick Track ID
            </a>
          <% } %>
        </div>
      </div>
    </div>
  </section>

  <!-- Live Statistics Section -->
  <section style="background-color: #ffffff; border-bottom: 1px solid var(--border-color); padding: 2.5rem 0;">
    <div class="container">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 2rem; text-align: center;">
        <div>
          <div style="font-size: 2.5rem; font-weight: 800; color: var(--primary); font-family: var(--font-heading);"><%= stats.total %>+</div>
          <div style="font-size: 0.95rem; font-weight: 600; color: var(--text-muted); margin-top: 0.25rem;">Grievances Processed</div>
        </div>
        <div>
          <div style="font-size: 2.5rem; font-weight: 800; color: var(--success); font-family: var(--font-heading);"><%= stats.resolved %>+</div>
          <div style="font-size: 0.95rem; font-weight: 600; color: var(--text-muted); margin-top: 0.25rem;">Successfully Resolved</div>
        </div>
        <div>
          <div style="font-size: 2.5rem; font-weight: 800; color: var(--accent); font-family: var(--font-heading);"><%= stats.rate %>%</div>
          <div style="font-size: 0.95rem; font-weight: 600; color: var(--text-muted); margin-top: 0.25rem;">Resolution Satisfaction</div>
        </div>
        <div>
          <div style="font-size: 2.5rem; font-weight: 800; color: #8b5cf6; font-family: var(--font-heading);"><%= stats.departments %></div>
          <div style="font-size: 0.95rem; font-weight: 600; color: var(--text-muted); margin-top: 0.25rem;">Campus Departments</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Workflow Section -->
  <section id="workflow" style="padding: 5rem 0; background-color: #f8fafc;">
    <div class="container">
      <div style="text-align: center; max-width: 650px; margin: 0 auto 3.5rem;">
        <span style="color: var(--primary); font-weight: 700; text-transform: uppercase; font-size: 0.825rem; letter-spacing: 1px;">Structured Redressal</span>
        <h2 style="font-size: 2.25rem; margin-top: 0.5rem; margin-bottom: 1rem;">Transparent Lifecycle of Every Complaint</h2>
        <p style="color: var(--text-muted);">From immediate submission to final verification, every step is logged and audited.</p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1.5rem;">
        <div class="card" style="text-align: center; padding: 2rem 1.25rem;">
          <div style="width: 50px; height: 50px; border-radius: 50%; background-color: var(--secondary-light); color: var(--secondary); display: flex; align-items: center; justify-content: center; margin: 0 auto 1.25rem; font-size: 1.35rem; font-weight: 700;">1</div>
          <h4 style="font-size: 1.05rem; margin-bottom: 0.5rem;">Submitted</h4>
          <p style="font-size: 0.85rem; color: var(--text-muted);">Student lodges grievance with category & proof attachments.</p>
        </div>

        <div class="card" style="text-align: center; padding: 2rem 1.25rem;">
          <div style="width: 50px; height: 50px; border-radius: 50%; background-color: var(--warning-light); color: var(--warning); display: flex; align-items: center; justify-content: center; margin: 0 auto 1.25rem; font-size: 1.35rem; font-weight: 700;">2</div>
          <h4 style="font-size: 1.05rem; margin-bottom: 0.5rem;">Under Review</h4>
          <p style="font-size: 0.85rem; color: var(--text-muted);">Admin verifies authenticity, urgency and assigns department.</p>
        </div>

        <div class="card" style="text-align: center; padding: 2rem 1.25rem;">
          <div style="width: 50px; height: 50px; border-radius: 50%; background-color: var(--info-light); color: var(--info); display: flex; align-items: center; justify-content: center; margin: 0 auto 1.25rem; font-size: 1.35rem; font-weight: 700;">3</div>
          <h4 style="font-size: 1.05rem; margin-bottom: 0.5rem;">Assigned</h4>
          <p style="font-size: 0.85rem; color: var(--text-muted);">Dedicated faculty/staff supervisor is tasked with the resolution.</p>
        </div>

        <div class="card" style="text-align: center; padding: 2rem 1.25rem;">
          <div style="width: 50px; height: 50px; border-radius: 50%; background-color: var(--primary-light); color: var(--primary); display: flex; align-items: center; justify-content: center; margin: 0 auto 1.25rem; font-size: 1.35rem; font-weight: 700;">4</div>
          <h4 style="font-size: 1.05rem; margin-bottom: 0.5rem;">In Progress</h4>
          <p style="font-size: 0.85rem; color: var(--text-muted);">Active inspection, repairs, or academic redressal underway.</p>
        </div>

        <div class="card" style="text-align: center; padding: 2rem 1.25rem;">
          <div style="width: 50px; height: 50px; border-radius: 50%; background-color: var(--success-light); color: var(--success); display: flex; align-items: center; justify-content: center; margin: 0 auto 1.25rem; font-size: 1.35rem; font-weight: 700;">5</div>
          <h4 style="font-size: 1.05rem; margin-bottom: 0.5rem;">Resolved</h4>
          <p style="font-size: 0.85rem; color: var(--text-muted);">Staff submits resolution report. Student rates the outcome.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section id="features" style="padding: 5rem 0; background-color: #ffffff;">
    <div class="container">
      <div style="text-align: center; max-width: 650px; margin: 0 auto 3.5rem;">
        <span style="color: var(--primary); font-weight: 700; text-transform: uppercase; font-size: 0.825rem; letter-spacing: 1px;">Platform Highlights</span>
        <h2 style="font-size: 2.25rem; margin-top: 0.5rem; margin-bottom: 1rem;">Built for Student Welfare & Campus Excellence</h2>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2rem;">
        <div class="card" style="padding: 2rem;">
          <div style="font-size: 2.25rem; color: var(--primary); margin-bottom: 1rem;"><i class="bi bi-shield-lock-fill"></i></div>
          <h3 style="font-size: 1.25rem; margin-bottom: 0.75rem;">Role-Based Security</h3>
          <p style="color: var(--text-muted); font-size: 0.95rem;">Strict access isolation across Students, Staff, and Administrators with bcrypt password hashing and session tokens.</p>
        </div>

        <div class="card" style="padding: 2rem;">
          <div style="font-size: 2.25rem; color: var(--success); margin-bottom: 1rem;"><i class="bi bi-file-earmark-arrow-up-fill"></i></div>
          <h3 style="font-size: 1.25rem; margin-bottom: 0.75rem;">Multer File Attachments</h3>
          <p style="color: var(--text-muted); font-size: 0.95rem;">Attach photographic evidence, bills, or PDF official requests (up to 5MB) directly during grievance lodgement.</p>
        </div>

        <div class="card" style="padding: 2rem;">
          <div style="font-size: 2.25rem; color: var(--warning); margin-bottom: 1rem;"><i class="bi bi-bell-fill"></i></div>
          <h3 style="font-size: 1.25rem; margin-bottom: 0.75rem;">Automated In-App Alerts</h3>
          <p style="color: var(--text-muted); font-size: 0.95rem;">Students and staff receive real-time database-backed notifications whenever comments, assignments, or statuses change.</p>
        </div>

        <div class="card" style="padding: 2rem;">
          <div style="font-size: 2.25rem; color: var(--accent); margin-bottom: 1rem;"><i class="bi bi-bar-chart-line-fill"></i></div>
          <h3 style="font-size: 1.25rem; margin-bottom: 0.75rem;">Administrative Analytics</h3>
          <p style="color: var(--text-muted); font-size: 0.95rem;">Comprehensive Chart.js visualizations, department-wise breakdowns, and one-click CSV report exports.</p>
        </div>

        <div class="card" style="padding: 2rem;">
          <div style="font-size: 2.25rem; color: #8b5cf6; margin-bottom: 1rem;"><i class="bi bi-star-fill"></i></div>
          <h3 style="font-size: 1.25rem; margin-bottom: 0.75rem;">Student Feedback Loop</h3>
          <p style="color: var(--text-muted); font-size: 0.95rem;">Students review and rate resolution quality (1 to 5 stars), keeping departmental accountability consistently high.</p>
        </div>

        <div class="card" style="padding: 2rem;">
          <div style="font-size: 2.25rem; color: #ef4444; margin-bottom: 1rem;"><i class="bi bi-qr-code-scan"></i></div>
          <h3 style="font-size: 1.25rem; margin-bottom: 0.75rem;">Public Tracking Portal</h3>
          <p style="color: var(--text-muted); font-size: 0.95rem;">Track any grievance status by Complaint ID without exposing sensitive student personal contact info.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact & Institutional Info -->
  <section id="contact" style="padding: 4.5rem 0; background-color: #f8fafc; border-top: 1px solid var(--border-color);">
    <div class="container">
      <div style="background: #ffffff; border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 3rem 2.5rem; box-shadow: var(--shadow-sm); display: grid; grid-template-columns: 1.5fr 1fr; gap: 3rem; align-items: center;">
        <div>
          <span style="color: var(--primary); font-weight: 700; text-transform: uppercase; font-size: 0.825rem; letter-spacing: 1px;">Campus Support</span>
          <h2 style="font-size: 2rem; margin-top: 0.5rem; margin-bottom: 1rem;">VFSTR Hyderabad Campus Grievance Cell</h2>
          <p style="color: var(--text-muted); margin-bottom: 1.5rem; line-height: 1.7;">
            The Grievance Redressal Committee at VFSTR Hyderabad Campus is committed to maintaining a safe, inclusive, and academically conducive environment. Urgent issues can also be directed to the campus cell.
          </p>
          <div style="display: flex; flex-direction: column; gap: 0.75rem;">
            <div style="display: flex; align-items: center; gap: 0.75rem; color: var(--text-main); font-weight: 600;">
              <i class="bi bi-geo-alt-fill" style="color: var(--primary); font-size: 1.25rem;"></i>
              <span>VFSTR Hyderabad Off-Campus Centre, Hyderabad, Telangana</span>
            </div>
            <div style="display: flex; align-items: center; gap: 0.75rem; color: var(--text-main); font-weight: 600;">
              <i class="bi bi-envelope-fill" style="color: var(--primary); font-size: 1.25rem;"></i>
              <span>campuscare@vfstr.ac.in</span>
            </div>
            <div style="display: flex; align-items: center; gap: 0.75rem; color: var(--text-main); font-weight: 600;">
              <i class="bi bi-telephone-fill" style="color: var(--primary); font-size: 1.25rem;"></i>
              <span>+91 98480 12345 / 040-23456789</span>
            </div>
          </div>
        </div>

        <div style="background-color: var(--primary-light); padding: 2rem; border-radius: var(--radius-md); border: 1px solid #bfdbfe; text-align: center;">
          <i class="bi bi-shield-check" style="font-size: 3rem; color: var(--primary); margin-bottom: 1rem; display: block;"></i>
          <h4 style="font-size: 1.2rem; margin-bottom: 0.5rem; color: var(--primary-dark);">Immediate Assistance Needed?</h4>
          <p style="font-size: 0.9rem; color: #1e3a8a; margin-bottom: 1.25rem;">Anti-ragging and urgent medical or security emergencies are addressed on highest priority.</p>
          <a href="/auth/login" class="btn btn-primary btn-block">Sign In to Lodge Grievance</a>
        </div>
      </div>
    </div>
  </section>
</main>

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-col">
        <h4 style="display: flex; align-items: center; gap: 0.5rem;">
          <img src="/images/logo.svg" alt="CampusCare Logo" style="filter: brightness(0) invert(1); height: 36px;">
        </h4>
        <p style="margin-top: 1rem; font-size: 0.9rem; line-height: 1.6;">
          CampusCare is the official centralized complaint and grievance management portal for Vignan's Foundation for Science, Technology & Research (VFSTR) Hyderabad Campus.
        </p>
      </div>

      <div class="footer-col">
        <h4>Quick Links</h4>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/track">Track Grievance</a></li>
          <li><a href="/#workflow">Lifecycle</a></li>
          <li><a href="/#features">Features</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4>User Portals</h4>
        <ul>
          <li><a href="/auth/login">Student Login</a></li>
          <li><a href="/auth/login">Staff Login</a></li>
          <li><a href="/auth/login">Admin Console</a></li>
          <li><a href="/auth/register">New Student Registration</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4>Campus Office</h4>
        <p style="font-size: 0.875rem; margin-bottom: 0.5rem;">VFSTR Hyderabad Campus</p>
        <p style="font-size: 0.875rem; margin-bottom: 0.5rem;">Hyderabad, Telangana, India</p>
        <p style="font-size: 0.875rem;">Email: campuscare@vfstr.ac.in</p>
      </div>
    </div>

    <div class="footer-bottom">
      <div>&copy; <%= currentYear %> <%= collegeName %>. All Rights Reserved.</div>
      <div>Designed & Developed for VFSTR Campus Redressal.</div>
    </div>
  </div>
</footer>

<%- include('partials/footer', { isDashboard: false }) %>
