<%- include('../partials/header', { pageTitle: 'Department Management - CampusCare VFSTR', isDashboard: true }) %>

<div class="dashboard-layout">
  <%- include('../partials/sidebar') %>

  <div class="dashboard-main">
    <header class="dashboard-topbar">
      <div style="display: flex; align-items: center;">
        <button class="mobile-toggle" aria-label="Toggle navigation menu">
          <i class="bi bi-list"></i>
        </button>
        <div class="topbar-title">
          <h2>Campus Departments Management</h2>
          <p>Configure grievance routing units and department heads</p>
        </div>
      </div>
    </header>

    <main class="dashboard-content">
      <%- include('../partials/alerts') %>

      <div style="display: grid; grid-template-columns: 1.8fr 1.2fr; gap: 2rem;">
        <!-- Departments List Table -->
        <div class="card">
          <div class="card-header">
            <h3><i class="bi bi-building" style="color: var(--primary);"></i> Enrolled Campus Departments</h3>
            <span style="font-size: 0.8rem; color: var(--text-muted);"><%= departments.length %> Active Units</span>
          </div>
          <div class="card-body" style="padding: 0;">
            <div class="table-responsive">
              <table class="data-table">
                <thead>
                  <tr>
                    <th>Code</th>
                    <th>Department Name</th>
                    <th>Head / In-charge</th>
                    <th>Complaints</th>
                    <th>Status</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (departments && departments.length > 0) { %>
                    <% departments.forEach(dept => { %>
                      <tr>
                        <td><strong><%= dept.code %></strong></td>
                        <td>
                          <div style="font-weight: 600;"><%= dept.name %></div>
                          <span style="font-size: 0.775rem; color: var(--text-muted);"><%= dept.description || 'No description' %></span>
                        </td>
                        <td><%= dept.head || 'HOD' %></td>
                        <td>
                          <span class="badge" style="background-color: var(--primary-light); color: var(--primary);">
                            <%= countMap[dept._id.toString()] || 0 %>
                          </span>
                        </td>
                        <td>
                          <span class="badge <%= dept.isActive ? 'badge-resolved' : 'badge-closed' %>">
                            <%= dept.isActive ? 'ACTIVE' : 'INACTIVE' %>
                          </span>
                        </td>
                      </tr>
                    <% }) %>
                  <% } else { %>
                    <tr>
                      <td colspan="5" style="text-align: center; padding: 2rem;">No departments configured.</td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- Add Department Form -->
        <div class="card" style="border-top: 4px solid var(--primary);">
          <div class="card-header">
            <h3><i class="bi bi-plus-circle" style="color: var(--primary);"></i> Add New Department</h3>
          </div>
          <div class="card-body">
            <form action="/admin/departments" method="POST">
              <div class="form-group">
                <label class="form-label" for="deptName">Department Name <span class="required">*</span></label>
                <input type="text" id="deptName" name="name" class="form-control" placeholder="e.g. Mechanical Engineering" required>
              </div>

              <div class="form-group">
                <label class="form-label" for="deptCode">Department Code <span class="required">*</span></label>
                <input type="text" id="deptCode" name="code" class="form-control" placeholder="e.g. MECH" required maxlength="10" style="text-transform: uppercase;">
              </div>

              <div class="form-group">
                <label class="form-label" for="deptHead">Department Head / Coordinator</label>
                <input type="text" id="deptHead" name="head" class="form-control" placeholder="e.g. Dr. K. Satyanarayana">
              </div>

              <div class="form-group">
                <label class="form-label" for="deptDesc">Description / Coverage</label>
                <textarea id="deptDesc" name="description" rows="3" class="form-control" placeholder="Scope of grievances handled by this unit..."></textarea>
              </div>

              <button type="submit" class="btn btn-primary btn-block">
                <i class="bi bi-building-add"></i> Create Department
              </button>
            </form>
          </div>
        </div>
      </div>
    </main>
  </div>
</div>

<%- include('../partials/footer', { isDashboard: true }) %>

