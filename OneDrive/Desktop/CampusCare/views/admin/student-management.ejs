<%- include('../partials/header', { pageTitle: 'Student Directory - CampusCare VFSTR', isDashboard: true }) %>

<div class="dashboard-layout">
  <%- include('../partials/sidebar') %>

  <div class="dashboard-main">
    <header class="dashboard-topbar">
      <div style="display: flex; align-items: center;">
        <button class="mobile-toggle" aria-label="Toggle navigation menu">
          <i class="bi bi-list"></i>
        </button>
        <div class="topbar-title">
          <h2>Enrolled Students Directory</h2>
          <p>Total <%= students.length %> registered students in CampusCare portal</p>
        </div>
      </div>
    </header>

    <main class="dashboard-content">
      <%- include('../partials/alerts') %>

      <!-- Filter Bar -->
      <div class="filter-bar">
        <form action="/admin/students" method="GET" style="display: flex; flex-wrap: wrap; gap: 0.75rem; width: 100%; align-items: center;">
          <div class="filter-input" style="flex: 2; min-width: 220px;">
            <input type="text" name="search" class="form-control" placeholder="Search by name, roll no, or email..." value="<%= filters.search || '' %>">
          </div>

          <div style="flex: 1; min-width: 170px;">
            <select name="department" class="form-select">
              <option value="ALL">All Departments</option>
              <% departments.forEach(dept => { %>
                <option value="<%= dept.name %>" <%= filters.department === dept.name ? 'selected' : '' %>><%= dept.name %></option>
              <% }) %>
            </select>
          </div>

          <div style="flex: 1; min-width: 140px;">
            <select name="status" class="form-select">
              <option value="ALL">All Statuses</option>
              <option value="ACTIVE" <%= filters.status === 'ACTIVE' ? 'selected' : '' %>>ACTIVE</option>
              <option value="SUSPENDED" <%= filters.status === 'SUSPENDED' ? 'selected' : '' %>>SUSPENDED</option>
            </select>
          </div>

          <button type="submit" class="btn btn-primary btn-sm" style="padding: 0.65rem 1.25rem;">
            <i class="bi bi-funnel"></i> Filter
          </button>
          <% if (filters.search || filters.department || filters.status) { %>
            <a href="/admin/students" class="btn btn-outline btn-sm">Reset</a>
          <% } %>
        </form>
      </div>

      <!-- Students Table -->
      <div class="card">
        <div class="card-body" style="padding: 0;">
          <div class="table-responsive">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Roll / Reg No</th>
                  <th>Student Name</th>
                  <th>Department</th>
                  <th>Email & Phone</th>
                  <th>Complaints Lodged</th>
                  <th>Account Status</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody>
                <% if (students && students.length > 0) { %>
                  <% students.forEach(student => { %>
                    <tr>
                      <td><strong><%= student.regNo || 'N/A' %></strong></td>
                      <td>
                        <div style="font-weight: 600;"><%= student.fullName %></div>
                        <span style="font-size: 0.75rem; color: var(--text-muted);">Joined: <%= new Date(student.createdAt).toLocaleDateString() %></span>
                      </td>
                      <td><%= student.department %></td>
                      <td>
                        <div style="font-size: 0.85rem;"><%= student.email %></div>
                        <span style="font-size: 0.75rem; color: var(--text-muted);"><%= student.phone || 'No phone' %></span>
                      </td>
                      <td>
                        <span class="badge" style="background-color: var(--primary-light); color: var(--primary);">
                          <%= studentCountMap[student._id.toString()] || 0 %>
                        </span>
                      </td>
                      <td>
                        <span class="badge <%= student.accountStatus === 'ACTIVE' ? 'badge-resolved' : 'badge-closed' %>">
                          <%= student.accountStatus %>
                        </span>
                      </td>
                      <td>
                        <form action="/admin/students/<%= student._id %>/toggle-status" method="POST" style="display: inline;">
                          <button type="submit" class="btn btn-outline btn-sm" title="Toggle active/suspended status" onclick="return confirm('Toggle status for <%= student.fullName %>?')">
                            <i class="bi <%= student.accountStatus === 'ACTIVE' ? 'bi-toggle-on text-success' : 'bi-toggle-off text-danger' %>"></i>
                            <%= student.accountStatus === 'ACTIVE' ? 'Active' : 'Suspended' %>
                          </button>
                        </form>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="7" style="text-align: center; padding: 3rem 1rem; color: var(--text-muted);">
                      No student records found matching search criteria.
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </main>
  </div>
</div>

<%- include('../partials/footer', { isDashboard: true }) %>

