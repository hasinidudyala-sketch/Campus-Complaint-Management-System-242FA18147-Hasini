<%- include('../partials/header', { pageTitle: 'All Grievances - CampusCare VFSTR', isDashboard: true }) %>

<div class="dashboard-layout">
  <%- include('../partials/sidebar') %>

  <div class="dashboard-main">
    <header class="dashboard-topbar">
      <div style="display: flex; align-items: center;">
        <button class="mobile-toggle" aria-label="Toggle navigation menu">
          <i class="bi bi-list"></i>
        </button>
        <div class="topbar-title">
          <h2>Master Complaints Directory</h2>
          <p>Total <%= complaints.length %> grievance records found</p>
        </div>
      </div>

      <div class="topbar-actions">
        <a href="/admin/reports/export-complaints" class="btn btn-outline btn-sm">
          <i class="bi bi-download"></i> Export CSV
        </a>
      </div>
    </header>

    <main class="dashboard-content">
      <%- include('../partials/alerts') %>

      <!-- Filter Bar -->
      <div class="filter-bar">
        <form action="/admin/complaints" method="GET" style="display: flex; flex-wrap: wrap; gap: 0.75rem; width: 100%; align-items: center;">
          <div class="filter-input" style="flex: 2; min-width: 220px;">
            <input type="text" name="search" class="form-control" placeholder="Search ID, title, student name..." value="<%= filters.search || '' %>">
          </div>

          <div style="flex: 1; min-width: 150px;">
            <select name="department" class="form-select">
              <option value="ALL">All Departments</option>
              <% departments.forEach(dept => { %>
                <option value="<%= dept._id %>" <%= filters.department === dept._id.toString() ? 'selected' : '' %>><%= dept.name %></option>
              <% }) %>
            </select>
          </div>

          <div style="flex: 1; min-width: 140px;">
            <select name="status" class="form-select">
              <option value="ALL">All Statuses</option>
              <% statuses.forEach(st => { %>
                <option value="<%= st %>" <%= filters.status === st ? 'selected' : '' %>><%= st %></option>
              <% }) %>
            </select>
          </div>

          <div style="flex: 1; min-width: 130px;">
            <select name="priority" class="form-select">
              <option value="ALL">All Priorities</option>
              <% priorities.forEach(pr => { %>
                <option value="<%= pr %>" <%= filters.priority === pr ? 'selected' : '' %>><%= pr %></option>
              <% }) %>
            </select>
          </div>

          <button type="submit" class="btn btn-primary btn-sm" style="padding: 0.65rem 1.25rem;">
            <i class="bi bi-funnel"></i> Filter
          </button>
          <% if (filters.search || filters.department || filters.status || filters.priority || filters.category) { %>
            <a href="/admin/complaints" class="btn btn-outline btn-sm">Reset</a>
          <% } %>
        </form>
      </div>

      <!-- Complaints Master Table -->
      <div class="card">
        <div class="card-body" style="padding: 0;">
          <div class="table-responsive">
            <table class="data-table">
              <thead>
                <tr>
                  <th>ID</th>
                  <th>Student Info</th>
                  <th>Title & Category</th>
                  <th>Department</th>
                  <th>Assigned Staff</th>
                  <th>Priority</th>
                  <th>Status</th>
                  <th>Date</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody>
                <% if (complaints && complaints.length > 0) { %>
                  <% complaints.forEach(complaint => { %>
                    <tr>
                      <td><strong><%= complaint.complaintId %></strong></td>
                      <td>
                        <div style="font-weight: 600;"><%= complaint.student ? complaint.student.fullName : 'N/A' %></div>
                        <span style="font-size: 0.775rem; color: var(--text-muted);"><%= complaint.student ? complaint.student.regNo : '' %></span>
                      </td>
                      <td>
                        <a href="/admin/complaint/<%= complaint._id %>" style="font-weight: 600; color: var(--text-main);">
                          <%= complaint.title %>
                        </a>
                        <div style="font-size: 0.75rem; color: var(--text-muted);"><%= complaint.category %></div>
                      </td>
                      <td><%= complaint.department ? complaint.department.code : 'Unassigned' %></td>
                      <td>
                        <% if (complaint.assignedStaff) { %>
                          <span style="font-weight: 500;"><%= complaint.assignedStaff.fullName %></span>
                        <% } else { %>
                          <span style="color: var(--danger); font-size: 0.8rem; font-weight: 600;">Unassigned</span>
                        <% } %>
                      </td>
                      <td>
                        <% if (complaint.priority === 'URGENT') { %>
                          <span class="badge badge-urgent">URGENT</span>
                        <% } else if (complaint.priority === 'HIGH') { %>
                          <span class="badge badge-high">HIGH</span>
                        <% } else if (complaint.priority === 'MEDIUM') { %>
                          <span class="badge badge-medium">MEDIUM</span>
                        <% } else { %>
                          <span class="badge badge-low">LOW</span>
                        <% } %>
                      </td>
                      <td>
                        <%- include('../partials/statusBadge', { status: complaint.status }) %>
                      </td>
                      <td style="font-size: 0.825rem; color: var(--text-muted);">
                        <%= new Date(complaint.createdAt).toLocaleDateString() %>
                      </td>
                      <td>
                        <a href="/admin/complaint/<%= complaint._id %>" class="btn btn-outline-primary btn-sm">
                          <i class="bi bi-sliders"></i> Manage
                        </a>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="9" style="text-align: center; padding: 3rem 1rem; color: var(--text-muted);">
                      <i class="bi bi-folder2-open" style="font-size: 2.5rem; display: block; margin-bottom: 0.5rem;"></i>
                      No grievances found in the master database.
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </main>
  </div>
</div>

<%- include('../partials/footer', { isDashboard: true }) %>

