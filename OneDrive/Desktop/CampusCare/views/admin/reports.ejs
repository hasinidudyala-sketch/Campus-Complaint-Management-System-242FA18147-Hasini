<%- include('../partials/header', { pageTitle: 'Grievance Reports & Analytics - CampusCare VFSTR', isDashboard: true }) %>

<div class="dashboard-layout">
  <%- include('../partials/sidebar') %>

  <div class="dashboard-main">
    <header class="dashboard-topbar">
      <div style="display: flex; align-items: center;">
        <button class="mobile-toggle" aria-label="Toggle navigation menu">
          <i class="bi bi-list"></i>
        </button>
        <div class="topbar-title">
          <h2>Grievance Redressal Reports & Exports</h2>
          <p>Institutional audit compliance & performance reports</p>
        </div>
      </div>

      <div class="topbar-actions">
        <a href="/admin/reports/export-complaints" class="btn btn-primary btn-sm">
          <i class="bi bi-file-earmark-spreadsheet-fill"></i> Download Complaints CSV
        </a>
      </div>
    </header>

    <main class="dashboard-content">
      <%- include('../partials/alerts') %>

      <!-- Export Banner Cards -->
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">
        <div class="card" style="padding: 1.5rem; display: flex; align-items: center; justify-content: space-between; border-left: 4px solid var(--primary);">
          <div>
            <h4 style="font-size: 1.1rem; margin-bottom: 0.25rem;">Complaints Master Data</h4>
            <p style="font-size: 0.85rem; color: var(--text-muted); margin: 0;">Full grievance log with status, staff, dates, and priorities.</p>
          </div>
          <a href="/admin/reports/export-complaints" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-download"></i> CSV
          </a>
        </div>

        <div class="card" style="padding: 1.5rem; display: flex; align-items: center; justify-content: space-between; border-left: 4px solid var(--success);">
          <div>
            <h4 style="font-size: 1.1rem; margin-bottom: 0.25rem;">Student Feedback Dataset</h4>
            <p style="font-size: 0.85rem; color: var(--text-muted); margin: 0;">Star ratings, quality metrics, and student reviews.</p>
          </div>
          <a href="/admin/reports/export-feedback" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-download"></i> CSV
          </a>
        </div>
      </div>

      <!-- Department Performance Matrix -->
      <div class="card" style="margin-bottom: 2rem;">
        <div class="card-header">
          <h3><i class="bi bi-building-check" style="color: var(--primary);"></i> Department Performance & Redressal Matrix</h3>
        </div>
        <div class="card-body" style="padding: 0;">
          <div class="table-responsive">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Department Name</th>
                  <th>Code</th>
                  <th>Total Lodged</th>
                  <th>Resolved / Closed</th>
                  <th>Pending Review</th>
                  <th>Resolution Rate (%)</th>
                </tr>
              </thead>
              <tbody>
                <% if (deptReport && deptReport.length > 0) { %>
                  <% deptReport.forEach(row => { 
                    const rate = row.total > 0 ? Math.round((row.resolved / row.total) * 100) : 0;
                  %>
                    <tr>
                      <td><strong><%= row.dept ? row.dept.name : 'General Administration' %></strong></td>
                      <td><%= row.dept ? row.dept.code : 'GEN' %></td>
                      <td><%= row.total %></td>
                      <td style="color: var(--success); font-weight: 600;"><%= row.resolved %></td>
                      <td style="color: var(--warning); font-weight: 600;"><%= row.pending %></td>
                      <td>
                        <div style="display: flex; align-items: center; gap: 0.75rem;">
                          <div style="flex: 1; height: 8px; background-color: var(--border-color); border-radius: 9999px; overflow: hidden; min-width: 80px;">
                            <div style="width: <%= rate %>%; height: 100%; background-color: <%= rate >= 80 ? 'var(--success)' : (rate >= 50 ? 'var(--warning)' : 'var(--danger)') %>;"></div>
                          </div>
                          <span style="font-weight: 700; font-size: 0.85rem;"><%= rate %>%</span>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="6" style="text-align: center; padding: 2rem;">No data recorded yet.</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Pipeline Distribution Grid -->
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
        <!-- Status Distribution -->
        <div class="card">
          <div class="card-header">
            <h3><i class="bi bi-diagram-3" style="color: var(--accent);"></i> Status Distribution</h3>
          </div>
          <div class="card-body">
            <div style="display: flex; flex-direction: column; gap: 0.85rem;">
              <% statusReport.forEach(st => { %>
                <div style="display: flex; justify-content: space-between; align-items: center; padding-bottom: 0.5rem; border-bottom: 1px solid var(--border-color);">
                  <span style="font-weight: 600;"><%= st._id %></span>
                  <span class="badge" style="background-color: var(--primary-light); color: var(--primary); font-size: 0.85rem;"><%= st.count %></span>
                </div>
              <% }) %>
            </div>
          </div>
        </div>

        <!-- Priority Distribution -->
        <div class="card">
          <div class="card-header">
            <h3><i class="bi bi-flag" style="color: var(--danger);"></i> Priority Distribution</h3>
          </div>
          <div class="card-body">
            <div style="display: flex; flex-direction: column; gap: 0.85rem;">
              <% priorityReport.forEach(pr => { %>
                <div style="display: flex; justify-content: space-between; align-items: center; padding-bottom: 0.5rem; border-bottom: 1px solid var(--border-color);">
                  <span style="font-weight: 600;"><%= pr._id %> PRIORITY</span>
                  <span class="badge <%= pr._id === 'URGENT' ? 'badge-urgent' : (pr._id === 'HIGH' ? 'badge-high' : 'badge-medium') %>">
                    <%= pr.count %>
                  </span>
                </div>
              <% }) %>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>
</div>

<%- include('../partials/footer', { isDashboard: true }) %>

