<%- include('../partials/header', { pageTitle: 'Staff Directory - CampusCare VFSTR', isDashboard: true }) %>

<div class="dashboard-layout">
  <%- include('../partials/sidebar') %>

  <div class="dashboard-main">
    <header class="dashboard-topbar">
      <div style="display: flex; align-items: center;">
        <button class="mobile-toggle" aria-label="Toggle navigation menu">
          <i class="bi bi-list"></i>
        </button>
        <div class="topbar-title">
          <h2>Grievance Staff & Faculty Directory</h2>
          <p>Supervise resolution officers across departments</p>
        </div>
      </div>
    </header>

    <main class="dashboard-content">
      <%- include('../partials/alerts') %>

      <div style="display: grid; grid-template-columns: 1.8fr 1.2fr; gap: 2rem;">
        <!-- Staff List Table -->
        <div class="card">
          <div class="card-header">
            <h3><i class="bi bi-person-badge" style="color: var(--primary);"></i> Registered Staff Members</h3>
            <span style="font-size: 0.8rem; color: var(--text-muted);"><%= staffMembers.length %> Officers</span>
          </div>
          <div class="card-body" style="padding: 0;">
            <div class="table-responsive">
              <table class="data-table">
                <thead>
                  <tr>
                    <th>Officer Name</th>
                    <th>Department & Role</th>
                    <th>Assigned</th>
                    <th>Status</th>
                    <th>Action</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (staffMembers && staffMembers.length > 0) { %>
                    <% staffMembers.forEach(staff => { %>
                      <tr>
                        <td>
                          <div style="font-weight: 600;"><%= staff.fullName %></div>
                          <span style="font-size: 0.775rem; color: var(--text-muted);"><%= staff.email %></span>
                        </td>
                        <td>
                          <div style="font-size: 0.85rem; font-weight: 500;"><%= staff.department %></div>
                          <span style="font-size: 0.75rem; color: var(--text-muted);"><%= staff.designation %></span>
                        </td>
                        <td>
                          <span class="badge" style="background-color: var(--primary-light); color: var(--primary);">
                            <%= staffCountMap[staff._id.toString()] || 0 %>
                          </span>
                        </td>
                        <td>
                          <span class="badge <%= staff.accountStatus === 'ACTIVE' ? 'badge-resolved' : 'badge-closed' %>">
                            <%= staff.accountStatus %>
                          </span>
                        </td>
                        <td>
                          <form action="/admin/staff/<%= staff._id %>/toggle-status" method="POST" style="display: inline;">
                            <button type="submit" class="btn btn-outline btn-sm" title="Toggle active status" onclick="return confirm('Toggle status for this staff member?')">
                              <i class="bi <%= staff.accountStatus === 'ACTIVE' ? 'bi-toggle-on text-success' : 'bi-toggle-off text-muted' %>"></i>
                            </button>
                          </form>
                        </td>
                      </tr>
                    <% }) %>
                  <% } else { %>
                    <tr>
                      <td colspan="5" style="text-align: center; padding: 2rem;">No staff registered.</td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- Add Staff Form -->
        <div class="card" style="border-top: 4px solid var(--primary);">
          <div class="card-header">
            <h3><i class="bi bi-person-plus-fill" style="color: var(--primary);"></i> Register New Staff Member</h3>
          </div>
          <div class="card-body">
            <form action="/admin/staff" method="POST">
              <div class="form-group">
                <label class="form-label" for="staffName">Full Name <span class="required">*</span></label>
                <input type="text" id="staffName" name="fullName" class="form-control" placeholder="e.g. Dr. K. Venkateswarlu" required>
              </div>

              <div class="form-group">
                <label class="form-label" for="staffEmail">Official Email <span class="required">*</span></label>
                <input type="email" id="staffEmail" name="email" class="form-control" placeholder="staff.dept@vfstr.ac.in" required>
              </div>

              <div class="form-group">
                <label class="form-label" for="staffPassword">Initial Password <span class="required">*</span></label>
                <input type="password" id="staffPassword" name="password" class="form-control" placeholder="Min 6 characters" required minlength="6">
              </div>

              <div class="form-group">
                <label class="form-label" for="staffDept">Assigned Department <span class="required">*</span></label>
                <select id="staffDept" name="department" class="form-select" required>
                  <% departments.forEach(dept => { %>
                    <option value="<%= dept.name %>"><%= dept.name %> (<%= dept.code %>)</option>
                  <% }) %>
                </select>
              </div>

              <div class="form-group">
                <label class="form-label" for="staffDesignation">Designation / Grievance Role</label>
                <input type="text" id="staffDesignation" name="designation" class="form-control" placeholder="e.g. Assistant Professor & Lab Coordinator">
              </div>

              <div class="form-group">
                <label class="form-label" for="staffPhone">Phone Number</label>
                <input type="tel" id="staffPhone" name="phone" class="form-control" placeholder="+91 98480 12345">
              </div>

              <button type="submit" class="btn btn-primary btn-block">
                <i class="bi bi-person-check-fill"></i> Provision Staff Account
              </button>
            </form>
          </div>
        </div>
      </div>
    </main>
  </div>
</div>

<%- include('../partials/footer', { isDashboard: true }) %>

