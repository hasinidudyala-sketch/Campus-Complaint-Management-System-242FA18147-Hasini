<%- include('../partials/header', { pageTitle: 'Admin Alerts - CampusCare VFSTR', isDashboard: true }) %>

<div class="dashboard-layout">
  <%- include('../partials/sidebar') %>

  <div class="dashboard-main">
    <header class="dashboard-topbar">
      <div style="display: flex; align-items: center;">
        <button class="mobile-toggle" aria-label="Toggle navigation menu">
          <i class="bi bi-list"></i>
        </button>
        <div class="topbar-title">
          <h2>Administrative Alerts & Notifications</h2>
          <p>Real-time campus-wide grievance alerts</p>
        </div>
      </div>

      <div class="topbar-actions">
        <% if (notifications && notifications.length > 0) { %>
          <form action="/notifications/mark-all-read" method="POST" style="display: inline;">
            <button type="submit" class="btn btn-outline btn-sm">
              <i class="bi bi-check2-all"></i> Mark All as Read
            </button>
          </form>
        <% } %>
      </div>
    </header>

    <main class="dashboard-content" style="max-width: 900px;">
      <%- include('../partials/alerts') %>

      <div class="card">
        <div class="card-body" style="padding: 1.5rem;">
          <% if (notifications && notifications.length > 0) { %>
            <div style="display: flex; flex-direction: column; gap: 1rem;">
              <% notifications.forEach(notif => { %>
                <div style="display: flex; justify-content: space-between; align-items: flex-start; padding: 1.25rem; border-radius: var(--radius-md); background-color: <%= notif.isRead ? '#ffffff' : 'var(--primary-light)' %>; border: 1px solid <%= notif.isRead ? 'var(--border-color)' : '#bfdbfe' %>; gap: 1rem;">
                  <div style="display: flex; gap: 1rem; align-items: flex-start;">
                    <div style="font-size: 1.5rem; color: <%= notif.type === 'SUCCESS' ? 'var(--success)' : (notif.type === 'ALERT' ? 'var(--danger)' : 'var(--primary)') %>;">
                      <i class="bi <%= notif.type === 'SUCCESS' ? 'bi-check-circle-fill' : (notif.type === 'ALERT' ? 'bi-exclamation-circle-fill' : 'bi-bell-fill') %>"></i>
                    </div>
                    <div>
                      <h4 style="font-size: 1rem; margin-bottom: 0.25rem; color: var(--text-main);"><%= notif.title %></h4>
                      <p style="font-size: 0.9rem; color: var(--text-muted); margin-bottom: 0.5rem; line-height: 1.5;"><%= notif.message %></p>
                      <div style="display: flex; align-items: center; gap: 1rem; font-size: 0.8rem; color: var(--text-light);">
                        <span><i class="bi bi-clock"></i> <%= new Date(notif.createdAt).toLocaleString() %></span>
                        <% if (notif.relatedComplaint) { %>
                          <a href="/admin/complaint/<%= notif.relatedComplaint._id %>" style="font-weight: 600;">Open Grievance</a>
                        <% } %>
                      </div>
                    </div>
                  </div>

                  <div style="display: flex; gap: 0.5rem;">
                    <% if (!notif.isRead) { %>
                      <form action="/notifications/<%= notif._id %>/mark-read" method="POST">
                        <button type="submit" class="btn btn-outline btn-sm" title="Mark as read">
                          <i class="bi bi-check"></i>
                        </button>
                      </form>
                    <% } %>
                    <form action="/notifications/<%= notif._id %>/delete" method="POST">
                      <button type="submit" class="btn btn-outline btn-sm" title="Delete alert" onclick="return confirm('Delete this alert?')">
                        <i class="bi bi-trash"></i>
                      </button>
                    </form>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <div style="text-align: center; padding: 4rem 1rem; color: var(--text-muted);">
              <i class="bi bi-bell-slash" style="font-size: 3rem; display: block; margin-bottom: 0.75rem; color: var(--text-light);"></i>
              <h3>No Alerts Pending</h3>
              <p>Everything is quiet. No unread notifications for campus administration.</p>
            </div>
          <% } %>
        </div>
      </div>
    </main>
  </div>
</div>

<%- include('../partials/footer', { isDashboard: true }) %>

