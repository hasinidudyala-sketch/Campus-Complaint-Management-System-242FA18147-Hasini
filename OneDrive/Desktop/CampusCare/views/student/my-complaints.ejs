<%- include('../partials/header', { pageTitle: 'My Complaints - CampusCare VFSTR', isDashboard: true }) %>

<div class="dashboard-layout">
  <%- include('../partials/sidebar') %>

  <div class="dashboard-main">
    <header class="dashboard-topbar">
      <div style="display: flex; align-items: center;">
        <button class="mobile-toggle" aria-label="Toggle navigation menu">
          <i class="bi bi-list"></i>
        </button>
        <div class="topbar-title">
          <h2>My Complaints Record</h2>
          <p>History and live status of your lodged grievances</p>
        </div>
      </div>

      <div class="topbar-actions">
        <a href="/student/submit-complaint" class="btn btn-primary btn-sm">
          <i class="bi bi-plus-lg"></i> New Grievance
        </a>
      </div>
    </header>

    <main class="dashboard-content">
      <%- include('../partials/alerts') %>

      <!-- Filter Bar -->
      <div class="filter-bar">
        <form action="/student/complaints" method="GET" style="display: flex; flex-wrap: wrap; gap: 0.75rem; width: 100%; align-items: center;">
          <div class="filter-input" style="flex: 2; min-width: 200px;">
            <input type="text" name="search" class="form-control" placeholder="Search by Complaint ID, Title or keyword..." value="<%= filters.search || '' %>">
          </div>

          <div style="flex: 1; min-width: 150px;">
            <select name="status" class="form-select">
              <option value="ALL">All Statuses</option>
              <% statuses.forEach(st => { %>
                <option value="<%= st %>" <%= filters.status === st ? 'selected' : '' %>><%= st %></option>
              <% }) %>
            </select>
          </div>

          <div style="flex: 1; min-width: 150px;">
            <select name="category" class="form-select">
              <option value="ALL">All Categories</option>
              <% categories.forEach(cat => { %>
                <option value="<%= cat %>" <%= filters.category === cat ? 'selected' : '' %>><%= cat %></option>
              <% }) %>
            </select>
          </div>

          <div style="flex: 1; min-width: 130px;">
            <select name="priority" class="form-select">
              <option value="ALL">All Priorities</option>
              <% priorities.forEach(pr => { %>
                <option value="<%= pr %>" <%= filters.priority === pr ? 'selected' : '' %>><%= pr %></option>
              <% }) %>
            </select>
          </div>

          <button type="submit" class="btn btn-primary btn-sm" style="padding: 0.65rem 1.25rem;">
            <i class="bi bi-funnel"></i> Filter
          </button>
          <% if (filters.search || filters.status || filters.category || filters.priority) { %>
            <a href="/student/complaints" class="btn btn-outline btn-sm">Reset</a>
          <% } %>
        </form>
      </div>

      <!-- Complaints Table -->
      <div class="card">
        <div class="card-body" style="padding: 0;">
          <div class="table-responsive">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Complaint ID</th>
                  <th>Grievance Title</th>
                  <th>Category</th>
                  <th>Department</th>
                  <th>Priority</th>
                  <th>Status</th>
                  <th>Lodged Date</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% if (complaints && complaints.length > 0) { %>
                  <% complaints.forEach(complaint => { %>
                    <tr>
                      <td>
                        <strong><%= complaint.complaintId %></strong>
                      </td>
                      <td>
                        <a href="/student/complaint/<%= complaint._id %>" style="font-weight: 600; color: var(--text-main);">
                          <%= complaint.title %>
                        </a>
                      </td>
                      <td><%= complaint.category %></td>
                      <td><%= complaint.department ? complaint.department.name : 'General' %></td>
                      <td>
                        <% if (complaint.priority === 'URGENT') { %>
                          <span class="badge badge-urgent">URGENT</span>
                        <% } else if (complaint.priority === 'HIGH') { %>
                          <span class="badge badge-high">HIGH</span>
                        <% } else if (complaint.priority === 'MEDIUM') { %>
                          <span class="badge badge-medium">MEDIUM</span>
                        <% } else { %>
                          <span class="badge badge-low">LOW</span>
                        <% } %>
                      </td>
                      <td>
                        <%- include('../partials/statusBadge', { status: complaint.status }) %>
                      </td>
                      <td style="font-size: 0.85rem; color: var(--text-muted);">
                        <%= new Date(complaint.createdAt).toLocaleDateString() %>
                      </td>
                      <td>
                        <a href="/student/complaint/<%= complaint._id %>" class="btn btn-outline-primary btn-sm">
                          <i class="bi bi-eye"></i> Track
                        </a>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="8" style="text-align: center; padding: 3rem 1rem; color: var(--text-muted);">
                      <i class="bi bi-folder2-open" style="font-size: 2.5rem; display: block; margin-bottom: 0.5rem;"></i>
                      No grievances found matching the selected filters.
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </main>
  </div>
</div>

<%- include('../partials/footer', { isDashboard: true }) %>

