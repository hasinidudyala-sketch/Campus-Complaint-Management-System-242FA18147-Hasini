<%- include('partials/header', { pageTitle: 'Track Grievance Status - CampusCare VFSTR', isDashboard: false }) %>
<%- include('partials/navbar') %>

<main class="main-content" style="padding: 3.5rem 0;">
  <div class="container" style="max-width: 820px;">
    <div style="text-align: center; margin-bottom: 2.5rem;">
      <h1 style="font-size: 2.25rem; font-weight: 800; margin-bottom: 0.75rem;">Track Grievance Status</h1>
      <p style="color: var(--text-muted); font-size: 1.05rem;">Enter your unique Complaint ID (e.g. <code>CC-2026-1001</code>) to track current progress and history.</p>
    </div>

    <!-- Search Form -->
    <div class="card" style="margin-bottom: 2rem;">
      <div class="card-body" style="padding: 2rem;">
        <form action="/track" method="GET" style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
          <div style="flex: 1; min-width: 250px;">
            <input type="text" name="complaintId" class="form-control" placeholder="Enter Complaint ID (e.g. CC-2026-1001)" value="<%= complaintId || '' %>" required style="font-size: 1.05rem; padding: 0.8rem 1.2rem; text-transform: uppercase;">
          </div>
          <button type="submit" class="btn btn-primary" style="padding: 0.8rem 1.75rem; font-size: 1rem;">
            <i class="bi bi-search"></i> Track Status
          </button>
        </form>
      </div>
    </div>

    <!-- Results Section -->
    <% if (searched) { %>
      <% if (complaint) { %>
        <div class="card" style="border-top: 4px solid var(--primary);">
          <div class="card-header">
            <div>
              <span style="font-size: 0.8rem; font-weight: 700; color: var(--primary); text-transform: uppercase;">Tracking Details</span>
              <h3 style="font-size: 1.35rem; margin-top: 0.2rem;"><%= complaint.title %></h3>
            </div>
            <div>
              <%- include('partials/statusBadge', { status: complaint.status }) %>
            </div>
          </div>
          <div class="card-body">
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.25rem; margin-bottom: 1.5rem; background-color: var(--secondary-light); padding: 1.25rem; border-radius: var(--radius-md);">
              <div>
                <span class="form-hint" style="display: block;">Complaint ID</span>
                <strong style="font-size: 1.05rem; color: var(--text-main);"><%= complaint.complaintId %></strong>
              </div>
              <div>
                <span class="form-hint" style="display: block;">Department</span>
                <strong style="color: var(--text-main);"><%= complaint.department ? complaint.department.name : 'Unassigned / In Review' %></strong>
              </div>
              <div>
                <span class="form-hint" style="display: block;">Category</span>
                <strong style="color: var(--text-main);"><%= complaint.category %></strong>
              </div>
              <div>
                <span class="form-hint" style="display: block;">Lodged On</span>
                <strong style="color: var(--text-main);"><%= new Date(complaint.createdAt).toLocaleDateString() %></strong>
              </div>
            </div>

            <div style="margin-bottom: 2rem;">
              <h4 style="font-size: 1rem; margin-bottom: 0.5rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Grievance Summary</h4>
              <p style="color: var(--text-main); line-height: 1.6;"><%= complaint.description %></p>
            </div>

            <!-- Status History Timeline -->
            <h4 style="font-size: 1.05rem; margin-bottom: 1rem; border-bottom: 1px solid var(--border-color); padding-bottom: 0.5rem;">
              <i class="bi bi-clock-history"></i> Progress Timeline
            </h4>
            
            <div class="timeline">
              <% if (complaint.statusHistory && complaint.statusHistory.length > 0) { %>
                <% complaint.statusHistory.forEach((hist, idx) => { %>
                  <div class="timeline-item">
                    <div class="timeline-marker <%= hist.status === 'RESOLVED' || hist.status === 'CLOSED' ? 'resolved' : (idx === complaint.statusHistory.length - 1 ? 'active' : '') %>"></div>
                    <div class="timeline-content">
                      <div class="timeline-header">
                        <span class="timeline-title"><%= hist.status %></span>
                        <span class="timeline-date"><%= new Date(hist.timestamp).toLocaleString() %></span>
                      </div>
                      <% if (hist.remarks) { %>
                        <div class="timeline-remark"><%= hist.remarks %></div>
                      <% } %>
                    </div>
                  </div>
                <% }) %>
              <% } else { %>
                <p style="color: var(--text-muted);">No timeline updates available yet.</p>
              <% } %>
            </div>
          </div>
          <div class="card-footer" style="display: flex; justify-content: space-between; align-items: center;">
            <span style="font-size: 0.85rem; color: var(--text-muted);">For full details or feedback, please sign in to your student account.</span>
            <a href="/auth/login" class="btn btn-sm btn-outline-primary">Sign In</a>
          </div>
        </div>
      <% } else { %>
        <div class="card" style="text-align: center; padding: 3rem 1.5rem;">
          <div style="font-size: 3rem; color: var(--danger); margin-bottom: 1rem;"><i class="bi bi-exclamation-circle"></i></div>
          <h3 style="margin-bottom: 0.5rem;">Grievance Not Found</h3>
          <p style="color: var(--text-muted); max-width: 450px; margin: 0 auto 1.5rem;">
            No complaint was found matching ID "<strong><%= complaintId %></strong>". Please double check your Complaint ID format.
          </p>
          <a href="/track" class="btn btn-outline">Try Another Search</a>
        </div>
      <% } %>
    <% } %>
  </div>
</main>

<%- include('partials/footer', { isDashboard: false }) %>

