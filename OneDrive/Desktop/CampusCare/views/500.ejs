<%- include('partials/header', { pageTitle: '500 - Server Error | CampusCare VFSTR', isDashboard: false }) %>
<%- include('partials/navbar') %>

<main class="main-content" style="padding: 5rem 0; text-align: center;">
  <div class="container" style="max-width: 600px;">
    <div style="font-size: 6rem; font-weight: 800; color: var(--danger); font-family: var(--font-heading); line-height: 1;">500</div>
    <h2 style="font-size: 2rem; margin: 1rem 0;">Internal Server Error</h2>
    <p style="color: var(--text-muted); font-size: 1.1rem; margin-bottom: 2rem;">
      <%= message || 'An unexpected server condition was encountered. Our engineering team has been alerted.' %>
    </p>
    <div style="display: flex; justify-content: center; gap: 1rem;">
      <a href="/" class="btn btn-primary"><i class="bi bi-house-door"></i> Return to Safety</a>
      <a href="/auth/login" class="btn btn-outline"><i class="bi bi-box-arrow-in-right"></i> Member Login</a>
    </div>
  </div>
</main>

<%- include('partials/footer', { isDashboard: false }) %>

